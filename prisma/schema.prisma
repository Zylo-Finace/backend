  @@index([vertical])
  @@index([status])
  @@index([createdAt])
  @@map("zylo_ramp_bill_purchases")
}

/// Singleton ops config for WhatsApp ramp rates / limits (admin dashboard editable).
model ZyRampSettings {
  id              Int      @id @default(1)
  /// NGN per 1 USDC when user sells crypto → Naira.
  sellRateNgn     Int      @map("sell_rate_ngn")
  /// NGN per 1 USDC when user buys crypto → pays Naira.
  buyRateNgn      Int      @map("buy_rate_ngn")
  maxOrderUsdc    Decimal  @map("max_order_usdc") @db.Decimal(18, 6)
  minBankSendNgn  Int      @map("min_bank_send_ngn")
  maxBankSendNgn  Int      @map("max_bank_send_ngn")
  sellFeeNgn      Int      @default(0) @map("sell_fee_ngn")
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("zylo_ramp_settings")
}

/// Lifetime volume counters for USDC/XLM that moves through Zylo (internal only).
model ZyRampVolumeStats {
  id            Int      @id @default(1)
  usdcVolume    Decimal  @default(0) @map("usdc_volume") @db.Decimal(24, 6)
  xlmVolume     Decimal  @default(0) @map("xlm_volume") @db.Decimal(24, 6)
  usdcTransfers Int      @default(0) @map("usdc_transfers")
  xlmTransfers  Int      @default(0) @map("xlm_transfers")
  transferCount Int      @default(0) @map("transfer_count")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("zylo_ramp_volume_stats")
}

/// One row per counted movement — unique on dedupeKey so retries / inbound+outbound don’t double-count.
model ZyRampVolumeEvent {
  id        Int      @id @default(autoincrement())
  /// Usually Stellar tx hash; else synthetic e.g. buy:ref / sell:ref.
  dedupeKey String   @unique @map("dedupe_key") @db.VarChar(160)
  asset     String   @db.VarChar(8)
  amount    Decimal  @db.Decimal(24, 6)
  kind      String   @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([asset])
  @@index([kind])
  @@map("zylo_ramp_volume_events")
}

// =============================================================================
//  PROFILE MEDIA
// =============================================================================

/// A customer's profile photo, re-encoded server-side.
///
/// Stored in the database rather than an object store because there is no
/// object store yet, and the image is small by construction: every upload is
/// decoded, EXIF-stripped and re-encoded to a 256×256 WebP (~10 KB) before it
/// is written. Anything that fails to decode is rejected, so this column never
/// holds arbitrary bytes a browser might sniff into something executable.
model UserAvatar {
  userId      String   @id @db.Uuid
  tenantId    String   @db.Uuid
  contentType String   @db.VarChar(32)
  data        Bytes
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("user_avatars")
}

// =============================================================================
//  BANJEE POINTS & REFERRALS
// =============================================================================

enum RewardReason {
  SIGNUP
  DAILY_CHECK_IN
  STREAK_BONUS
  TRANSACTION_MILESTONE
  REFERRAL_REFERRER
  REFERRAL_REFEREE
  /// Operator correction. Negative amounts allowed.
  ADJUSTMENT
}

/// Per-customer rewards state: balance, streak and referral code.
///
/// `pointsBalance` is a cache of `SUM(reward_ledger_entries.points)`, updated in
/// the same transaction as every ledger insert, so the two never disagree.
model RewardProfile {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid
  userId   String @db.Uuid

  /// Shareable code, e.g. `ADA7K2QF`. Uppercase, no ambiguous characters.
  referralCode String @db.VarChar(16)

  pointsBalance  Int @default(0)
  lifetimePoints Int @default(0)

  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  /// Calendar day (Africa/Lagos) of the last check-in.
  lastCheckInDate DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@unique([tenantId, referralCode])
  @@map("reward_profiles")
}

/// Append-only points ledger. One row per award.
///
/// `dedupeKey` makes every award idempotent: `signup`, `checkin:2026-09-16`,
/// `milestone:10`, `referral:<refereeId>`. A retry, a double-click or two
/// concurrent requests collapse onto the unique index instead of paying twice.
model RewardLedgerEntry {
  id        String       @id @default(uuid(7)) @db.Uuid
  tenantId  String       @db.Uuid
  userId    String       @db.Uuid
  reason    RewardReason
  points    Int
  dedupeKey String       @db.VarChar(96)
  /// Customer-facing line, e.g. "7-day streak bonus".
  label     String       @db.VarChar(160)
  metadata  Json?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([tenantId, userId, createdAt(sort: Desc)])
  @@map("reward_ledger_entries")
}

enum ReferralStatus {
  /// Signed up with a code; has not yet done what qualifies the reward.
  PENDING
  /// Qualified and both sides were paid.
  REWARDED
  /// Blocked by a fraud rule (same identity, cap reached, ...). Never paid.
  REJECTED
}

/// Who invited whom. A customer can be referred at most once, ever.
model Referral {
  id              String         @id @default(uuid(7)) @db.Uuid
  tenantId        String         @db.Uuid
  referrerId      String         @db.Uuid
  refereeId       String         @db.Uuid
  status          ReferralStatus @default(PENDING)
  /// Customer-safe reason for a REJECTED referral.
  rejectionReason String?        @db.VarChar(255)
  /// Signup IP, for the same-device fraud check. Not shown to customers.
  signupIp        String?        @db.VarChar(45)
  rewardedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  referrer User @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("ReferralReferee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@unique([refereeId])
  @@index([tenantId, referrerId, createdAt(sort: Desc)])
  @@index([tenantId, status])
  @@map("referrals")
}
