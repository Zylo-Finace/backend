/// WhatsApp → Nigerian bank send (USDC wallet → FalconPay NGN payout).
model ZyRampBankSend {
  id                Int       @id @default(autoincrement())
  /// Our payout / FalconPay reference (idempotency key).
  ref               String    @unique @db.VarChar(64)
  phone             String    @db.VarChar(32)
  amountNgn         Int       @map("amount_ngn")
  amountUsdc        Decimal   @map("amount_usdc") @db.Decimal(18, 6)
  rate              Int
  bankCode          String    @map("bank_code") @db.VarChar(16)
  bankName          String    @map("bank_name") @db.VarChar(120)
  accountNumber     String    @map("account_number") @db.VarChar(20)
  accountName       String    @map("account_name") @db.VarChar(160)
  status            String    @db.VarChar(32)
  /// Platform User id used for ledger hold / FalconPay payout (when linked).
  platformUserId    String?   @map("platform_user_id") @db.Uuid
  /// stellar | celo — which crypto float funded this payout.
  chain             String    @default("stellar") @db.VarChar(16)
  stellarTxHash     String?   @map("stellar_tx_hash") @db.VarChar(128)
  celoTxHash        String?   @map("celo_tx_hash") @db.VarChar(66)
  providerReference String?   @map("provider_reference") @db.VarChar(128)
  failureReason     String?   @map("failure_reason") @db.VarChar(512)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  completedAt       DateTime? @map("completed_at")

  @@index([phone])
  @@index([status])
  @@map("zylo_ramp_bank_sends")
}

/// WhatsApp bill payment (airtime, data, electricity, cable TV, betting).
/// Crypto is debited to the vault; this row is the admin audit / volume source.
model ZyRampBillPurchase {
  id                Int      @id @default(autoincrement())
  ref               String   @unique @db.VarChar(64)
  phone             String   @db.VarChar(32)
  /// airtime | data | electricity | cable | betting
  vertical          String   @db.VarChar(32)
  amountNgn         Int      @map("amount_ngn")
  amountUsdc        Decimal  @map("amount_usdc") @db.Decimal(18, 6)
  rate              Int
  /// Product label: network, DISCO, TV provider, betting company, etc.
  productLabel      String?  @map("product_label") @db.VarChar(160)
  /// Meter / smartcard / MSISDN / betting customer id.
  customerId        String?  @map("customer_id") @db.VarChar(64)
  customerName      String?  @map("customer_name") @db.VarChar(160)
  status            String   @db.VarChar(32)
  chain             String   @default("stellar") @db.VarChar(16)
  stellarTxHash     String?  @map("stellar_tx_hash") @db.VarChar(128)
  celoTxHash        String?  @map("celo_tx_hash") @db.VarChar(66)
  providerReference String?  @map("provider_reference") @db.VarChar(128)
  failureReason     String?  @map("failure_reason") @db.VarChar(512)
  createdAt         DateTime @default(now()) @map("created_at")
