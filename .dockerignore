# Anything not needed to build or run. Keeping this tight shrinks the build
# context, speeds up layer hashing, and — critically — stops `.env` from ever
# being copied into an image layer.
node_modules
dist
coverage
.git
.github
.husky
*.log
logs

.env
.env.*
!.env.example

# Tests and tooling are not part of the runtime image.
test
**/*.spec.ts
**/*.e2e-spec.ts
.eslintcache
eslint.config.mjs
.prettierrc

docker-compose*.yml
Dockerfile*
README.md
docs
.vscode
.idea
