# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public base URL of this API. Used for building absolute links (webhooks, media).
APP_URL=http://localhost:3000
APP_NAME=wabot-platform
# Comma-separated allowlist. Use explicit origins in production, never "*".
# Production must include the Vercel portal origin or browser login fails CORS:
#   https://zylo-iota-eight.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,https://zylo-iota-eight.vercel.app
# Trust N reverse-proxy hops (nginx = 1). Controls req.ip / rate-limit correctness.
TRUST_PROXY_HOPS=1
# Global request body size limit.
BODY_LIMIT=2mb
# Graceful shutdown budget (ms) — must be < the orchestrator's terminationGracePeriod.
SHUTDOWN_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://wabot:wabot@localhost:5432/wabot?schema=public
# Per-process pool size. Total = DB_POOL_SIZE * replicas; keep under Postgres max_connections.
DB_POOL_SIZE=15
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=15000
# Emit Prisma query logs (very chatty — development only).
DB_LOG_QUERIES=false
# Log any query slower than this (ms). 0 disables.
DB_SLOW_QUERY_MS=300

# ---------------------------------------------------------------------------
# Redis (cache + BullMQ + Socket.IO adapter)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Logical key namespace; lets multiple environments share one Redis safely.
REDIS_KEY_PREFIX=wabot
REDIS_TLS=false

# ---------------------------------------------------------------------------
# Security / Crypto
# ---------------------------------------------------------------------------
# 32-byte base64 key for AES-256-GCM field encryption. Generate:
#   openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_base64_48
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_base64_48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=wabot-platform
# Ops console phones (comma-separated). Sign in with WhatsApp transfer PIN.
ADMIN_PHONES=08060332714,08102950347

# ---------------------------------------------------------------------------
# Rate limiting (global default; per-tenant plan overrides live in the DB)
# ---------------------------------------------------------------------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=600

# ---------------------------------------------------------------------------
# Payments (Nigerian virtual accounts + funding webhooks)
# ---------------------------------------------------------------------------
# Active provider: paystack | payvessel | flutterwave | monnify | manual
PAYMENT_PROVIDER=paystack
# Secret key. Also the HMAC key Paystack signs webhooks with — treat as a credential.
PAYSTACK_SECRET_KEY=sk_test_CHANGE_ME
PAYSTACK_BASE_URL=https://api.paystack.co
# Bank that issues the dedicated virtual account (Paystack: wema-bank | titan-bank).
PAYSTACK_PREFERRED_BANK=wema-bank
# Outbound call budget. Beyond this the circuit opens and provisioning is retried.
PAYMENT_HTTP_TIMEOUT_MS=10000
# Reject webhooks whose payload is older than this (replay protection), 0 disables.
WEBHOOK_MAX_AGE_SECONDS=300

# ---------------------------------------------------------------------------
# PayVessel (virtual accounts + BVN/NIN verification)
# ---------------------------------------------------------------------------
# Used for two things: STATIC accounts (permanent, one per fully-verified
# customer, requires a BVN or NIN) and DYNAMIC accounts (single-use, one per
# on-ramp order, no identity needed). Set PAYMENT_PROVIDER=payvessel to make it
# the funding provider; the dynamic/on-ramp path uses it either way.
PAYVESSEL_BASE_URL=https://api.payvessel.com
# Sandbox: https://sandbox.payvessel.com — refused in production, deliberately.
PAYVESSEL_KYC_BASE_URL=https://api.payvessel.com/kyc
# Production keys start PVKEY- / PVSECRET-. Sent as `api-key` / `api-secret`.
PAYVESSEL_API_KEY=CHANGE_ME_payvessel_api_key
# Also the HMAC-SHA512 key PayVessel signs webhooks with — one secret, both
# directions, so rolling it invalidates in-flight webhook deliveries too.
PAYVESSEL_API_SECRET=CHANGE_ME_payvessel_api_secret
# Merchant business id from the PayVessel dashboard.
PAYVESSEL_BUSINESS_ID=CHANGE_ME_payvessel_business_id
# Partner banks for permanent accounts, most-preferred first.
# 999991 PalmPay | 120001 9 Payment Service Bank | 090175 Rubies MFB
PAYVESSEL_STATIC_BANK_CODES=999991,120001
# Single-use accounts: only 9PSB (120001) and Rubies MFB (090175) support these.
PAYVESSEL_DYNAMIC_BANK_CODE=120001
# How long a single-use account is advertised. Keep below PayVessel's own expiry:
# money sent to a spent account is refunded to the payer, not credited to us.
PAYVESSEL_DYNAMIC_ACCOUNT_TTL_MINUTES=30
# Addresses PayVessel delivers webhooks from. Defence in depth behind the HMAC.
PAYVESSEL_WEBHOOK_IPS=3.255.23.38,162.246.254.36
# Reject webhooks from unlisted addresses. Must stay true in production.
PAYVESSEL_WEBHOOK_ENFORCE_IPS=true

# ---------------------------------------------------------------------------
# KYC (identity verification and the tier ladder)
# ---------------------------------------------------------------------------
# payvessel | disabled. `disabled` boots fine and fails every verification call
# closed — it never approves anybody silently.
KYC_PROVIDER=disabled
# The ladder:
#   tier_0  registered, nothing proven
#   tier_1  BVN verified — customer supplies BVN + phone + DOB, both matched
#   tier_2  NIN verified and consistent with the BVN already on file
#   tier_3  tier 2 plus a manual review
# Tier required before a permanent account is requested from a partner bank.
KYC_STATIC_ACCOUNT_MIN_TIER=tier_2
# Name-similarity floor (0-100) for a provider basic check to count as a match.
KYC_NAME_MATCH_MIN_PERCENT=70
# Name-similarity floor (0-100) for the tier-2 NIN-vs-BVN comparison. Higher,
# because both sides are government registries rather than a customer's typing,
# and clearing it is what unlocks a permanent bank account.
KYC_CROSS_MATCH_NAME_MIN_PERCENT=80
# Failed verification attempts allowed per customer per rolling day. Tier 1
# reveals whether a DOB matches a BVN; unlimited retries make that an oracle.
KYC_MAX_FAILED_ATTEMPTS_PER_DAY=5
# Allow one BVN/NIN across several customers. Off: that is the shape of bonus
# farming and mule networks, and it is far cheaper to block than to unwind.
KYC_ALLOW_DUPLICATE_IDENTIFIERS=false

# ---------------------------------------------------------------------------
# WhatsApp (Meta Cloud API)
# ---------------------------------------------------------------------------
# App Secret from the Meta app dashboard. Meta signs every webhook with it —
# this is the ONLY authentication on the webhook endpoint.
META_APP_SECRET=CHANGE_ME_meta_app_secret
# Shared string echoed during Meta's GET verification handshake. Pick a long random value.
META_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_meta_verify_token
META_GRAPH_BASE_URL=https://graph.facebook.com
# Pin the Graph version. Meta ships breaking changes between versions and
# unpinned calls silently follow the default forward.
META_GRAPH_VERSION=v21.0
WHATSAPP_HTTP_TIMEOUT_MS=15000
# Meta's free-form messaging window, in hours. 24 is their published value;
# configurable only so tests can shrink it.
WHATSAPP_SERVICE_WINDOW_HOURS=24

# ---------------------------------------------------------------------------
# BANJEE ramp (WhatsApp USDC ↔ NGN) — consumer chat on/off-ramp
# Webhook: GET/POST /api/whatsapp/webhook
# ---------------------------------------------------------------------------
WA_RAMP_ENABLED=true
WA_RAMP_BRAND_NAME=Banjee
# Public web portal (reply “web” in WhatsApp)
WA_RAMP_WEB_PORTAL_URL=https://zylo-iota-eight.vercel.app
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PHONE_NUMBER_ID_LIVE=
# Can match META_WEBHOOK_VERIFY_TOKEN or a dedicated string
WHATSAPP_VERIFY_TOKEN=wa-ramp-verify
# BIP-39 mnemonic for per-user Celo EOAs (index 0 = gas sponsor)
WA_RAMP_CELO_DEPOSIT_ADDRESS=
WA_RAMP_CELO_HD_MNEMONIC=
WA_RAMP_CELO_USDC_ADDRESS=0xcebA9300f2b948710d2653dD7B07f33A8B32118C
WA_RAMP_CELO_USDT_ADDRESS=0x48065fbBE25f71C9282ddf5e1cD6D6A887483D5e
WA_RAMP_CELO_CUSD_ADDRESS=0x765de816845861e75A25Fca8693AA1d4d8e6cDd6
WA_RAMP_USDC_ADDRESS=0xcebA9300f2b948710d2653dD7B07f33A8B32118C
CELO_RPC_URL=https://forno.celo.org
WA_RAMP_STELLAR_DEPOSIT_ADDRESS=
# Classic G… custody (preferred). BIP-39 mnemonic — not the Celo one.
WA_RAMP_STELLAR_HD_MNEMONIC=
# XLM sent when creating each G… account (reserves + USDC trustline + fees)
WA_RAMP_STELLAR_ACTIVATION_XLM=2
WA_RAMP_STELLAR_HORIZON_URL=
# Per-user Soroban smart wallets (factory). Kept to drain legacy C… wallets.
WA_RAMP_STELLAR_FACTORY_ID=
WA_RAMP_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
WA_RAMP_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
WA_RAMP_STELLAR_OPERATOR_SECRET=
WA_RAMP_STELLAR_USDC_ISSUER=
WA_RAMP_NGN_BANK_NAME=Opay
WA_RAMP_NGN_ACCOUNT_NUMBER=
WA_RAMP_NGN_ACCOUNT_NAME=
WA_RAMP_RATE_SELL_NGN=1550
WA_RAMP_RATE_BUY_NGN=1600
# Flat NGN fee on sell (itemized on quote; 0 = free)
WA_RAMP_SELL_FEE_NGN=0
# Sell quote lock window (seconds) before re-quote is required
WA_RAMP_RATE_QUOTE_SECONDS=90
WA_RAMP_MAX_ORDER_USDC=1
WA_RAMP_ORDER_TTL_MINUTES=20
WA_RAMP_ADMIN_WHATSAPP_NUMBER=
WA_RAMP_CHAINS_LABEL=Celo & Stellar
# Platform tenant UUID for WhatsApp → FalconPay Naira bank sends (ledger + payouts)
WA_RAMP_TENANT_ID=
WA_RAMP_MIN_BANK_SEND_NGN=100
WA_RAMP_MAX_BANK_SEND_NGN=500000
# PIN defaults to typing in chat. Enable popup only after Meta verifies + Flow published:
# WA_RAMP_PIN_FLOW_ENABLED=true
# WA_RAMP_PIN_FLOW_ID=
# WA_RAMP_ONBOARD_FLOW_ID=
# WA_RAMP_FLOW_MODE=draft


# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=debug
# "pretty" for local TTY, "json" everywhere else.
LOG_FORMAT=pretty
METRICS_ENABLED=true
TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=wabot-api
# Head sampling ratio 0.0–1.0. Keep low at high traffic.
OTEL_SAMPLE_RATIO=0.1


# -----------------------------------------------------------------------------
# Payouts — FalconPay (outward transfers / withdrawals)
# -----------------------------------------------------------------------------
# Separate from PAYMENT_PROVIDER above: that one issues the dedicated accounts
# money arrives in, this one sends money out to third-party NUBANs.
PAYOUT_PROVIDER=falconpay

# Who re-places a transfer the primary could not accept. `manual` (the default)
# means no failover — a refused transfer fails, as it did before this existed.
#
# Failover here is far narrower than on bills, and deliberately so: a NIP
# transfer is irreversible, so a second attempt is only ever made when the
# primary *definitely* queued nothing (an outright refusal, an empty float, an
# open circuit). A timeout or a 5xx never triggers one — "no answer" is not the
# same as "no", and re-placing an in-flight transfer sends the money twice.
PAYOUT_FALLBACK_PROVIDER=manual

# Sandbox: https://sandbox.falconpay.ng/v1 (with an sk_test_ key, no real money).
FALCONPAY_API_URL=https://payment.falconpay.ng/v1
# Dashboard -> Developer -> API Keys. sk_live_ in production; booting production
# with an sk_test_ key is refused.
FALCONPAY_SECRET_KEY=
# Unused for server-to-server calls; kept for dashboard parity.
FALCONPAY_PUBLIC_KEY=
# whsec_live_<64 hex>, shown once when the webhook is registered. Signs inbound
# status updates — without it no payout can ever reach a terminal state.
FALCONPAY_WEBHOOK_SECRET=
# Registered with FalconPay, not read by the app. Must point at this service's
# /api/falconpay/webhook route. Transfer and bill events both arrive there.
FALCONPAY_WEBHOOK_URL=https://zylo-production.up.railway.app/api/falconpay/webhook
# What the recipient sees on their bank statement.
FALCONPAY_SENDER_NAME=BANJEE

# Our own ceiling and floor per payout, in whole naira. FalconPay accepts only
# integer naira amounts, so sub-naira balances can never be withdrawn.
PAYOUT_MIN_AMOUNT_NAIRA=100
PAYOUT_MAX_AMOUNT_NAIRA=1000000


# -----------------------------------------------------------------------------
# Bill payments (airtime, data, electricity, cable TV, betting)
# -----------------------------------------------------------------------------
# A third, independent leg: this neither issues funding accounts nor sends money
# to banks. It delivers value against a prepaid float held with the provider, and
# every order is refused locally if that float cannot cover it.
#
# falconpay | clubkonnect | smeplug | disabled
#   falconpay    primary provider for all bill verticals, paid from the FalconPay wallet
#                (uses the FALCONPAY_* keys above; needs a live key and a registered webhook)
#   clubkonnect  all bill verticals via ClubKonnect
#   smeplug      leads on airtime and data (SMEPlug) and routes other bills to ClubKonnect
#   NOTE: dotenv does not override — set BILLS_PROVIDER only once in .env.
BILLS_PROVIDER=falconpay

# The *last* airtime/data tier, tried after both providers above. `disabled`
# (the default) leaves the existing two-provider chain exactly as it was.
# Only `pulsemfb` is accepted — the other values name providers already in the
# chain, and putting one behind itself just doubles a failed order's latency.
BILLS_VAS_FALLBACK_PROVIDER=disabled

# ClubKonnect serves the same API from clubkonnect.com and its original
# nellobytesystems.com host. Every documented endpoint uses the latter.
CLUBKONNECT_BASE_URL=https://www.nellobytesystems.com

# Dashboard -> API. NOTE: this API takes credentials as *query parameters*, so a
# request URL is itself a secret — never log one.
CLUBKONNECT_USER_ID=
CLUBKONNECT_API_KEY=

# Where ClubKonnect posts order status transitions. Sent per request rather than
# registered once. These callbacks are unsigned, so they are treated as a hint to
# re-query an order, never as proof of its outcome.
CLUBKONNECT_CALLBACK_URL=https://zylo-production.up.railway.app/api/clubkonnect/webhook

# Generous, because these calls sit in front of mobile networks and disco billing
# systems. Too short a deadline manufactures unknown outcomes: we abandon a
# request the provider went on to fulfil.
CLUBKONNECT_HTTP_TIMEOUT_MS=30000

# Float held back, in whole naira. Absorbs the gap between reading the balance
# and the provider debiting it while other orders are in flight.
CLUBKONNECT_FLOAT_RESERVE_NAIRA=0

# How long a float reading may be reused. Short because it gates spending — a
# stale-high figure lets through orders the provider will refuse. 0 reads live.
CLUBKONNECT_BALANCE_CACHE_SECONDS=15

# Plans and package prices change on the order of days.
CLUBKONNECT_CATALOGUE_CACHE_SECONDS=3600

# -----------------------------------------------------------------------------
# Bill payments — SMEPlug (airtime + data primary when BILLS_PROVIDER=smeplug)
# -----------------------------------------------------------------------------
# Bearer token from SMEPlug dashboard (Authorization: Bearer …).
SMEPLUG_BASE_URL=https://smeplug.ng/api/v1
SMEPLUG_SECRET_KEY=

# Path secret for POST /api/v1/webhooks/smeplug/:token — at least 24 chars.
# Register the full URL in the SMEPlug dashboard.
SMEPLUG_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Pulse MFB — accounts, transfers and VAS off one API client
# -----------------------------------------------------------------------------
# Pulse is OFF unless this is true. Leave false so leftover Pulse env cannot
# take down FalconPay / WhatsApp. Turn on only with real keys + debit accounts.
PULSEMFB_ENABLED=false

# One set of credentials serves three roles, each opted into separately:
#   PAYMENT_PROVIDER=pulsemfb            issues dedicated NUBANs
#   PAYOUT_FALLBACK_PROVIDER=pulsemfb    backs up outward transfers
#   BILLS_VAS_FALLBACK_PROVIDER=pulsemfb backs up airtime and data
#
# Sandbox: http://test-api.pulsemfb.com (plain HTTP — development only; booting
# production against a non-HTTPS URL is refused).
PULSEMFB_BASE_URL=https://api.pulsemfb.com

# Dashboard -> API Clients -> Create. The private key is shown exactly once.
# It never goes on the wire: it keys the HMAC behind x-signature.
PULSEMFB_PUBLIC_KEY=
PULSEMFB_PRIVATE_KEY=

# Optional. Their docs describe signature auth, but parts of their published
# collection authenticate with a bare x-api-key. Sent alongside when set.
PULSEMFB_API_KEY=

# Keys X-Webhook-Signature. Regenerated whenever the webhook URL changes, so
# re-read it from the dashboard after any URL edit.
PULSEMFB_WEBHOOK_SECRET=

# Register this with Pulse (one URL per API client, all events):
#   https://<your-host>/api/pulsemfb/webhook

# Requests older than 5 minutes are rejected upstream as replays.
PULSEMFB_SIGNATURE_TTL_SECONDS=300
PULSEMFB_HTTP_TIMEOUT_MS=30000

# What customers are told to send money to. Their create-account response names
# no bank — from their side the answer is always "us" — so it comes from here.
PULSEMFB_BANK_CODE=090713
PULSEMFB_BANK_NAME=Pulse MFB

# Our float with Pulse, in the two spellings their API uses: transfers name it
# by NUBAN, VAS purchases name it by internal id. Same account.
PULSEMFB_DEBIT_ACCOUNT_NUMBER=
PULSEMFB_DEBIT_ACCOUNT_ID=
